# Copy to .env and adjust for your machine. Never commit .env.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# PostgreSQL 18 (development credentials only)
DATABASE_URL=postgresql+psycopg://silent:silent_dev@127.0.0.1:5432/silent_cinema

# Storage roots
STORAGE_ROOT=./data
MAX_UPLOAD_BYTES=2147483648
ALLOWED_VIDEO_EXTENSIONS=mp4,mkv,mov,avi,mpg,mpeg,webm

# External binaries
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
TESSERACT_BIN=tesseract
OCR_DEFAULT_LANGUAGE=eng

# Worker
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
PROCESS_TIMEOUT_SECONDS=900

# Optional external stum adapter (CC-BY-NC 4.0, non-commercial)
STUM_ENABLED=false
STUM_BIN=stum

# Logging
LOG_LEVEL=info
