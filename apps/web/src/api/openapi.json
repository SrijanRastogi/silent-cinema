  "info": {
    "description": "Local-first intertitle extraction and subtitle review for silent films.\n\nM1 exposes health and readiness only. Upload, processing, review, and export\nendpoints arrive in later milestones; they are not stubbed or faked here.\n",
    "title": "Silent Cinema in Your Language",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/films": {
      "get": {
        "operationId": "list_films_api_v1_films_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FilmSummary"
                  },
                  "title": "Response List Films Api V1 Films Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Films",
        "tags": [
          "films"
        ]
      },
      "post": {
        "description": "Upload one film and process it synchronously with real detection and OCR.\n\nThis request can take several minutes for a long film; no fake progress is\nreported. The worker queue in M3 replaces the synchronous call.",
        "operationId": "upload_film_api_v1_films_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_film_api_v1_films_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FilmDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload Film",
        "tags": [
          "films"
        ]
      }
    },
